{
	"name": "@bhsd/codemirror-mediawiki",
	"version": "3.15.0",
	"description": "Modified CodeMirror mode based on wikimedia/mediawiki-extensions-CodeMirror",
	"keywords": [
		"mediawiki",
		"wikitext",
		"codemirror"
	],
	"homepage": "https://github.com/bhsd-harry/codemirror-mediawiki#readme",
	"bugs": {
		"url": "https://github.com/bhsd-harry/codemirror-mediawiki/issues"
	},
	"license": "GPL-2.0-or-later",
	"files": [
		"/i18n/",
		"/dist/*.js",
		"/dist/*.d.ts",
		"!/dist/*.test.{js,d.ts}",
		"!/dist/demo.min.js"
	],
	"browser": "dist/main.min.js",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bhsd-harry/codemirror-mediawiki.git"
	},
	"scripts": {
		"ls": "npm i --package-lock-only && npm ls --package-lock-only --all --omit=dev",
		"prepublishOnly": "npm run build",
		"checkout": "git checkout wikitext wikitext.html wikitext-page.js wikitext-page.css",
		"build:css": "esbuild ./css/index.css --bundle --minify --outfile=mediawiki.css --supported:nesting=false",
		"build:core": "node build.cjs && tsc && esbuild src/config.ts src/javascript-globals.ts --bundle --format=esm --external:@lezer/highlight --outdir=dist --legal-comments=inline && rm dist/*-page.{js,d.ts} && gsed -i 's|globals/globals.json|globals|' dist/javascript-globals.d.ts && grep -rl --include='*.d.ts' '@private' dist/ | xargs gsed -i -E '/^\\s+\\/\\*\\* @private/,+1d'",
		"build:mw": "MODE=mw node build.cjs && esbuild ./mw/config.ts --charset=utf8 --bundle --target=es2019 --format=esm --outfile=dist/mwConfig.js --external:@bhsd/browser --external:@bhsd/cm-util",
		"build:wiki": "MODE=wiki node build.cjs",
		"build:gh-page": "esbuild src/*-page.ts --charset=utf8 --bundle --target=es2019 --format=esm --outdir=. --external:/codemirror-mediawiki/dist/main.min.js --external:/codemirror-mediawiki/dist/demo.min.js --external:/wikiparser-node/extensions/dist/test-page-common.js --external:/lezer-abusefilter/dist/dialect.test.js",
		"build:demo": "esbuild ./bundle/*.ts --charset=utf8 --bundle --format=esm --outdir=build --drop-labels=GH && esbuild ./bundle/mediawiki.ts --charset=utf8 --bundle --minify --target=es2019 --format=esm --outfile=dist/demo.min.js",
		"build:test": "rm -rf test/dist/; tsc --project test/tsconfig.json && npm test",
		"build": "npm run build:css && rm -rf dist/ && npm run build:demo && npm run build:core && npm run build:wiki && npm run build:mw && gsed -i '/^\\/\\/ /d' dist/*.js && eslint --no-config-lookup -c eslint.dist.mjs dist/*.min.js",
		"lint:ts": "tsc --noEmit && tsc --project mw/tsconfig.json --noEmit && tsc --project test/tsconfig.json --noEmit && tsc --project bundle/tsconfig.json --noEmit && eslint --cache .",
		"lint:css": "stylelint '**/*.css'",
		"lint:md": "markdownlint-cli2 '**/*.md'",
		"lint": "npm run lint:ts && npm run lint:css && npm run lint:md",
		"prof": "node test/dist/prof.js",
		"server": "npm run test:end; http-server .. -c-1 --cors -s &",
		"test": "mocha test/dist/*.test.js && mocha test/dist/test.js",
		"test:end": "pkill -x http-server",
		"test:real": "node test/dist/real.js",
		"test:math": "mocha test/dist/math.js",
		"diff": "git diff -w --color-moved --minimal npm wikitext"
	},
	"dependencies": {
		"@bhsd/browser": "^0.3.0",
		"@bhsd/cm-util": "^1.1.0",
		"@bhsd/codemirror-css-color-picker": "^7.1.0",
		"@bhsd/common": "^2.1.0",
		"@bhsd/eslint-browserify": "^10.2.1",
		"@bhsd/lezer-abusefilter": "^0.3.1",
		"@bhsd/stylelint-util": "^1.0.2",
		"@codemirror/autocomplete": "^6.20.1",
		"@codemirror/commands": "^6.10.3",
		"@codemirror/language": "^6.12.3",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-html": "^6.4.11",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-vue": "^0.1.3",
		"@codemirror/legacy-modes": "^6.5.2",
		"@codemirror/lint": "^6.9.5",
		"@codemirror/search": "^6.6.0",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.41.0",
		"cm6-theme-nord": "^0.2.0",
		"eslint": "^10.2.1",
		"globals": "^17.5.0",
		"luacheck-browserify": "^0.11.0",
		"stylelint": "^17.9.1",
		"wikiparser-node": "^1.39.1"
	},
	"devDependencies": {
		"@bhsd/code-standard": "^2.3.0",
		"@bhsd/nodejs": "^1.0.0",
		"@bhsd/test-util": "^1.1.0",
		"@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@stylistic/stylelint-plugin": "^5.1.0",
		"@types/jquery": "^3.5.34",
		"@types/mocha": "^10.0.10",
		"@types/node": "^24.11.0",
		"@types/oojs-ui": "^0.49.4",
		"@typescript-eslint/eslint-plugin": "^8.59.1",
		"@typescript-eslint/parser": "^8.59.1",
		"esbuild": "^0.28.0",
		"eslint-plugin-es-x": "^9.6.0",
		"eslint-plugin-jsdoc": "^62.9.0",
		"eslint-plugin-jsonc": "^3.1.2",
		"eslint-plugin-promise": "^7.3.0",
		"eslint-plugin-regexp": "^3.1.0",
		"eslint-plugin-unicorn": "^64.0.0",
		"eslint-plugin-yml": "^3.3.2",
		"http-server": "^14.1.1",
		"markdownlint-cli2": "^0.22.1",
		"marked": "^18.0.2",
		"mocha": "^11.7.5",
		"monaco-editor": "~0.53.0",
		"stylelint-config-recommended": "^18.0.0",
		"stylelint-plugin-use-baseline": "^1.4.1",
		"types-mediawiki": "^2.0.0",
		"typescript": "^6.0.3"
	}
}
