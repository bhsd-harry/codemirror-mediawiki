{
	"name": "@bhsd/codemirror-wikitext",
	"version": "0.6.0",
	"description": "Wikitext mode based on wikimedia/mediawiki-extensions-CodeMirror and language support extensions",
	"keywords": [
		"mediawiki",
		"wikitext",
		"codemirror"
	],
	"homepage": "https://github.com/bhsd-harry/codemirror-mediawiki/tree/wikitext#readme",
	"bugs": {
		"url": "https://github.com/bhsd-harry/codemirror-mediawiki/issues"
	},
	"license": "GPL-2.0-or-later",
	"files": [
		"/dist/*.js",
		"/dist/*.d.ts"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bhsd-harry/codemirror-mediawiki.git"
	},
	"scripts": {
		"ls": "npm i --package-lock-only && npm ls --package-lock-only --all --omit=dev",
		"prepublishOnly": "npm run build",
		"build:core": "tsc && esbuild src/config.ts --bundle --format=esm --external:@lezer/highlight --outfile=dist/config.js --legal-comments=inline && rm dist/*-page.{js,d.ts}",
		"build:gh-page": "esbuild src/*-page.ts --charset=utf8 --bundle --format=esm --outdir=build && esbuild src/*-page.ts --charset=utf8 --bundle --target=es2019 --format=esm --minify --sourcemap --outdir=.",
		"build": "rm -rf dist/ && npm run build:core && gsed -i '/^\\/\\/ /d' dist/*.js",
		"lint:ts": "tsc --noEmit && eslint --cache .",
		"lint:css": "stylelint *.css",
		"lint:md": "markdownlint-cli2 '**/*.md'",
		"lint": "npm run lint:ts && npm run lint:css && npm run lint:md",
		"server": "npm run test:end; http-server .. -c-1 --cors -s &",
		"test:end": "pkill -x http-server",
		"diff": "bash diff.sh"
	},
	"dependencies": {
		"@bhsd/browser": "^0.3.2",
		"@bhsd/cm-util": "^1.1.0",
		"@bhsd/codemirror-css-color-picker": "^7.1.0",
		"@bhsd/common": "^2.2.1",
		"@bhsd/stylelint-util": "^1.0.2",
		"@codemirror/autocomplete": "^6.20.2",
		"@codemirror/commands": "^6.10.3",
		"@codemirror/language": "^6.12.3",
		"@codemirror/lint": "^6.9.6",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.42.1",
		"marked": "^18.0.3",
		"wikiparser-node": "^1.40.0"
	},
	"devDependencies": {
		"@bhsd/code-standard": "^2.4.2",
		"@codemirror/search": "^6.7.0",
		"@stylistic/stylelint-plugin": "^5.1.0",
		"@types/node": "^25.8.0",
		"@typescript-eslint/parser": "^8.59.2",
		"diff2html-cli": "^5.2.15",
		"esbuild": "^0.28.0",
		"eslint": "^10.4.0",
		"http-server": "^14.1.1",
		"markdownlint-cli2": "^0.22.1",
		"stylelint": "^17.11.1",
		"stylelint-config-recommended": "^18.0.0",
		"stylelint-plugin-use-baseline": "^1.4.2",
		"typescript": "^6.0.3"
	}
}
