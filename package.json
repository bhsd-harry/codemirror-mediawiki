{
	"name": "@bhsd/codemirror-mediawiki",
	"version": "2.20.0",
	"description": "Modified CodeMirror mode based on wikimedia/mediawiki-extensions-CodeMirror",
	"keywords": [
		"mediawiki",
		"wikitext",
		"codemirror"
	],
	"homepage": "https://github.com/bhsd-harry/codemirror-mediawiki#readme",
	"bugs": {
		"url": "https://github.com/bhsd-harry/codemirror-mediawiki/issues"
	},
	"license": "GPL-2.0",
	"files": [
		"/i18n/",
		"/dist/*.js",
		"/dist/*.d.ts",
		"/dist/*.mjs",
		"!/dist/*-page.d.ts",
		"!/dist/parser.*",
		"/src/linter.ts",
		"/src/static.ts",
		"/mw/config.ts",
		"/mediawiki.css"
	],
	"browser": "dist/main.min.js",
	"main": "./dist/main.min.js",
	"types": "./dist/codemirror.d.ts",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bhsd-harry/codemirror-mediawiki.git"
	},
	"scripts": {
		"prepublishOnly": "npm run build",
		"build:core": "esbuild ./src/codemirror.ts --charset=utf8 --bundle --minify --target=es2019 --format=esm --sourcemap --outfile=dist/main.min.js && esbuild ./src/linter.ts --charset=utf8 --target=es2019 --format=esm --outfile=dist/linter.mjs && tsc --emitDeclarationOnly",
		"build:mw": "esbuild ./mw/base.ts --charset=utf8 --bundle --minify --target=es2019 --format=esm --outfile=dist/mw.min.js && esbuild ./mw/config.ts --charset=utf8 --bundle --target=es2019 --format=esm --outfile=dist/mwConfig.mjs",
		"build:wiki": "esbuild ./mw/base.ts --charset=utf8 --bundle --minify --target=es2019 --format=iife --sourcemap --outfile=dist/wiki.min.js",
		"build:gh-page": "bash build.sh",
		"build:test": "tsc --project test/tsconfig.json && mocha",
		"build": "npm run build:core && npm run build:mw && npm run build:wiki && eslint --no-eslintrc -c .eslintrc.dist.cjs dist/*.js",
		"lint:ts": "tsc --noEmit && tsc --project mw/tsconfig.json --noEmit && tsc --project test/tsconfig.json --noEmit && eslint --cache .",
		"lint:css": "stylelint *.css",
		"lint": "npm run lint:ts && npm run lint:css",
		"prof": "node --prof test/dist/test/prof.js && node --prof-process isolate-0x*-v8.log > test/prof.txt && gsed -i '0,/Bottom up/d' test/prof.txt && rm isolate-0x*-v8.log",
		"server": "npm run test:end; http-server .. -c-1 --cors -s &",
		"test": "npm run build:core && npm run build:wiki && npm run build:gh-page && npm run server",
		"test:end": "pkill -x http-server",
		"test:real": "node test/dist/test/real.js"
	},
	"dependencies": {
		"@bhsd/common": "^0.5.0",
		"@codemirror/language": "^6.10.6",
		"@codemirror/lint": "^6.8.4",
		"@codemirror/state": "^6.4.1",
		"@codemirror/view": "^6.35.0",
		"@lezer/common": "^1.2.3",
		"style-mod": "^4.1.0",
		"wikiparser-node": "^1.15.0"
	},
	"devDependencies": {
		"@codemirror/autocomplete": "^6.18.3",
		"@codemirror/commands": "^6.7.1",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-javascript": "^6.2.2",
		"@codemirror/lang-json": "^6.0.1",
		"@codemirror/legacy-modes": "^6.4.2",
		"@codemirror/search": "^6.5.8",
		"@lezer/highlight": "^1.2.1",
		"@replit/codemirror-css-color-picker": "^6.3.0",
		"@stylistic/eslint-plugin": "^2.11.0",
		"@stylistic/stylelint-plugin": "^3.1.1",
		"@types/eslint": "^8.56.10",
		"@types/jquery": "^3.5.32",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.10.1",
		"@types/oojs-ui": "^0.49.0",
		"@typescript-eslint/eslint-plugin": "^8.16.0",
		"@typescript-eslint/parser": "^8.16.0",
		"esbuild": "^0.24.0",
		"eslint": "^8.57.1",
		"eslint-plugin-es-x": "^8.4.1",
		"eslint-plugin-eslint-comments": "^3.2.0",
		"eslint-plugin-jsdoc": "^50.6.0",
		"eslint-plugin-json-es": "^1.6.0",
		"eslint-plugin-markdown": "4.0.1",
		"eslint-plugin-n": "^17.14.0",
		"eslint-plugin-promise": "^7.2.1",
		"eslint-plugin-regexp": "^2.6.0",
		"eslint-plugin-unicorn": "^56.0.1",
		"http-server": "^14.1.0",
		"luacheck-browserify": "^0.2.1",
		"mocha": "^10.8.2",
		"monaco-editor": "^0.52.0",
		"monaco-wiki": "^1.5.0",
		"stylelint": "^16.11.0",
		"stylelint-config-recommended": "^14.0.0",
		"types-mediawiki": "^1.9.0",
		"typescript": "^5.7.2"
	}
}
