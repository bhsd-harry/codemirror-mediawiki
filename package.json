{
	"name": "@bhsd/codemirror-mediawiki",
	"version": "2.30.2",
	"description": "Modified CodeMirror mode based on wikimedia/mediawiki-extensions-CodeMirror",
	"keywords": [
		"mediawiki",
		"wikitext",
		"codemirror"
	],
	"homepage": "https://github.com/bhsd-harry/codemirror-mediawiki#readme",
	"bugs": {
		"url": "https://github.com/bhsd-harry/codemirror-mediawiki/issues"
	},
	"license": "GPL-2.0",
	"files": [
		"/i18n/",
		"/dist/*.js",
		"/dist/*.d.ts",
		"/mediawiki.css"
	],
	"browser": "dist/main.min.js",
	"main": "./dist/codemirror.js",
	"module": "./dist/codemirror.js",
	"types": "./dist/codemirror.d.ts",
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bhsd-harry/codemirror-mediawiki.git"
	},
	"scripts": {
		"prepublishOnly": "npm run build",
		"bundle:core": "esbuild ./src/codemirror.ts --charset=utf8 --bundle --format=esm --outfile=build/main.js",
		"bundle:wiki": "node build.mjs",
		"build:css": "esbuild ./css/index.css --bundle --minify --outfile=mediawiki.css",
		"build:core": "npm run bundle:core && esbuild ./build/main.js --charset=utf8 --minify --target=es2019 --format=esm --sourcemap --outfile=dist/main.min.js && tsc && esbuild src/config.ts --bundle --format=esm --external:@lezer/highlight --outfile=dist/config.js --legal-comments=inline && rm dist/*-page.{js,d.ts}",
		"build:mw": "esbuild ./build/wiki.js --charset=utf8 --minify --target=es2019 --format=esm --outfile=dist/mw.min.js && esbuild ./mw/config.ts --charset=utf8 --bundle --target=es2019 --format=esm --outfile=dist/mwConfig.js",
		"build:wiki": "npm run bundle:wiki && esbuild ./build/wiki.js --charset=utf8 --minify --target=es2019 --format=iife --sourcemap --outfile=dist/wiki.min.js",
		"build:gh-page": "bash build.sh",
		"build:test": "tsc --project test/tsconfig.json && npm test",
		"build": "npm run build:css && rm -rf dist/ && npm run build:core && npm run build:wiki && npm run build:mw && eslint --no-eslintrc -c .eslintrc.dist.cjs dist/*.min.js",
		"lint:ts": "tsc --noEmit && tsc --project mw/tsconfig.json --noEmit && tsc --project test/tsconfig.json --noEmit && eslint --cache .",
		"lint:css": "stylelint **/*.css",
		"lint": "npm run lint:ts && npm run lint:css",
		"prof": "node --prof test/dist/test/prof.js && node --prof-process isolate-0x*-v8.log > test/prof.txt && gsed -i '0,/Bottom up/d' test/prof.txt && rm isolate-0x*-v8.log",
		"server": "npm run test:end; http-server .. -c-1 --cors -s &",
		"test": "mocha test/dist/test/*.test.js && mocha --reporter=progress test/dist/test/test.js",
		"test:end": "pkill -x http-server",
		"test:real": "node test/dist/test/real.js"
	},
	"dependencies": {
		"@bhsd/codemirror-css-color-picker": "^6.3.0",
		"@bhsd/common": "^0.14.1",
		"@codemirror/autocomplete": "^6.18.6",
		"@codemirror/commands": "^6.8.1",
		"@codemirror/language": "^6.11.2",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-javascript": "^6.2.2",
		"@codemirror/lang-json": "^6.0.1",
		"@codemirror/legacy-modes": "^6.4.2",
		"@codemirror/lint": "^6.8.5",
		"@codemirror/search": "^6.5.11",
		"@codemirror/state": "^6.5.2",
		"@codemirror/view": "^6.38.0",
		"@lezer/common": "^1.2.3",
		"@lezer/highlight": "^1.2.1",
		"wikiparser-node": "^1.21.2"
	},
	"devDependencies": {
		"@stylistic/eslint-plugin": "^3.1.0",
		"@stylistic/stylelint-plugin": "^3.1.2",
		"@types/eslint": "^8.56.10",
		"@types/jquery": "^3.5.32",
		"@types/markdown-it": "^14.1.2",
		"@types/mocha": "^10.0.10",
		"@types/node": "^24.0.10",
		"@types/oojs-ui": "^0.49.4",
		"@typescript-eslint/eslint-plugin": "^8.35.1",
		"@typescript-eslint/parser": "^8.35.1",
		"esbuild": "^0.25.5",
		"eslint": "^8.57.1",
		"eslint-plugin-es-x": "^8.7.0",
		"eslint-plugin-eslint-comments": "^3.2.0",
		"eslint-plugin-jsdoc": "^51.3.3",
		"eslint-plugin-json-es": "^1.6.0",
		"eslint-plugin-promise": "^7.2.1",
		"eslint-plugin-regexp": "^2.9.0",
		"eslint-plugin-unicorn": "^56.0.1",
		"http-server": "^14.1.1",
		"luacheck-browserify": "^0.7.0",
		"mocha": "^11.7.1",
		"monaco-editor": "^0.52.2",
		"stylelint": "^16.21.1",
		"stylelint-config-recommended": "^16.0.0",
		"types-mediawiki": "^1.10.1",
		"typescript": "^5.8.2"
	}
}
