{
	"name": "@bhsd/codemirror-wikitext",
	"version": "0.0.0",
	"description": "Wikitext mode based on wikimedia/mediawiki-extensions-CodeMirror and language support extensions",
	"keywords": [
		"mediawiki",
		"wikitext",
		"codemirror"
	],
	"homepage": "https://github.com/bhsd-harry/codemirror-mediawiki/tree/wikitext#readme",
	"bugs": {
		"url": "https://github.com/bhsd-harry/codemirror-mediawiki/issues"
	},
	"license": "GPL-2.0",
	"files": [
		"/dist/*.js",
		"/dist/*.d.ts",
		"!/dist/*-page.*"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bhsd-harry/codemirror-mediawiki.git"
	},
	"scripts": {
		"prepublishOnly": "npm run build",
		"bundle:gh-page": "esbuild src/*-page.ts --charset=utf8 --bundle --format=esm --outdir=build",
		"build:core": "tsc && esbuild src/config.ts --bundle --format=esm --external:@lezer/highlight --outfile=dist/config.js --legal-comments=inline",
		"build:gh-page": "npm run bundle:gh-page && esbuild build/*-page.js --charset=utf8 --target=es2019 --format=esm --minify --outdir=.",
		"build": "rm -rf dist/ && npm run build:core",
		"lint:ts": "tsc --noEmit && eslint --cache .",
		"lint:css": "stylelint **/*.css",
		"lint:md": "markdownlint-cli2 '**/*.md'",
		"lint": "npm run lint:ts && npm run lint:css && npm run lint:md",
		"diff": "git diff --ignore-all-space --color-moved --minimal npm wikitext"
	},
	"dependencies": {
		"@bhsd/browser": "^0.2.1",
		"@bhsd/cm-util": "^0.1.0",
		"@bhsd/codemirror-css-color-picker": "^6.3.0",
		"@bhsd/common": "^1.0.1",
		"@bhsd/stylelint-util": "^0.1.0",
		"@codemirror/autocomplete": "^6.20.0",
		"@codemirror/commands": "^6.10.1",
		"@codemirror/language": "^6.12.1",
		"@codemirror/lint": "^6.9.2",
		"@codemirror/state": "^6.5.3",
		"@codemirror/view": "^6.38.8",
		"marked": "^17.0.1",
		"wikiparser-node": "^1.33.0"
	},
	"devDependencies": {
		"@bhsd/code-standard": "^1.3.2",
		"@codemirror/search": "^6.5.11",
		"@stylistic/eslint-plugin": "^5.5.0",
		"@stylistic/stylelint-plugin": "^4.0.0",
		"@types/node": "^24.10.1",
		"@typescript-eslint/eslint-plugin": "^8.46.4",
		"@typescript-eslint/parser": "^8.46.4",
		"esbuild": "^0.25.12",
		"eslint": "^9.39.1",
		"eslint-plugin-es-x": "^9.1.2",
		"eslint-plugin-eslint-comments": "^3.2.0",
		"eslint-plugin-jsdoc": "^61.2.1",
		"eslint-plugin-jsonc": "^2.21.0",
		"eslint-plugin-promise": "^7.2.1",
		"eslint-plugin-regexp": "^2.10.0",
		"eslint-plugin-unicorn": "^62.0.0",
		"markdownlint-cli2": "^0.19.0",
		"stylelint": "^16.26.1",
		"stylelint-config-recommended": "^17.0.0",
		"stylelint-plugin-use-baseline": "^1.1.0",
		"typescript": "^5.9.3"
	}
}
