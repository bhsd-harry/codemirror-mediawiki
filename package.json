{
	"name": "@bhsd/codemirror-wikitext",
	"version": "0.11.1",
	"description": "Wikitext mode based on wikimedia/mediawiki-extensions-CodeMirror and language support extensions",
	"keywords": [
		"mediawiki",
		"wikitext",
		"codemirror"
	],
	"homepage": "https://github.com/bhsd-harry/codemirror-mediawiki/tree/wikitext#readme",
	"bugs": {
		"url": "https://github.com/bhsd-harry/codemirror-mediawiki/issues"
	},
	"license": "GPL-2.0-or-later",
	"files": [
		"/dist/*.js",
		"/dist/*.d.ts"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bhsd-harry/codemirror-mediawiki.git"
	},
	"scripts": {
		"ls": "npm i --package-lock-only && npm ls --package-lock-only --all --omit=dev",
		"prepublishOnly": "npm run build",
		"build:core": "tsc && esbuild src/config.ts --bundle --format=esm --external:@lezer/highlight --outfile=dist/config.js --legal-comments=inline && rm dist/*-page.{js,d.ts}",
		"build:gh-page": "esbuild src/*-page.ts --charset=utf8 --bundle --format=esm --outdir=build && esbuild src/*-page.ts --charset=utf8 --bundle --target=es2019 --format=esm --minify --sourcemap --outdir=.",
		"build": "rm -rf dist/ && npm run build:core && gsed -i '/^\\/\\/ /d' dist/*.js",
		"lint:ts": "tsc --noEmit && eslint --cache .",
		"lint:css": "stylelint *.css",
		"lint:md": "markdownlint-cli2 '**/*.md'",
		"lint": "npm run lint:ts && npm run lint:css && npm run lint:md",
		"server": "npm run test:end; http-server .. -c-1 --cors -s &",
		"test:end": "pkill -x http-server",
		"diff": "bash diff.sh"
	},
	"peerDependencies": {
		"@codemirror/autocomplete": "^6.0.0",
		"@codemirror/commands": "^6.0.0",
		"@codemirror/language": "^6.1.0",
		"@codemirror/lint": "^6.7.0",
		"@codemirror/search": "^6.0.0",
		"@codemirror/state": "^6.0.0",
		"@codemirror/view": "^6.39.0"
	},
	"dependencies": {
		"@bhsd/browser": "^2.1.1",
		"@bhsd/cm-util": "^2.4.1",
		"@bhsd/codemirror-css-color-picker": "^9.0.1",
		"@bhsd/codemirror-stickyscroll": "^0.1.0",
		"@bhsd/common": "^4.1.0",
		"@bhsd/stylelint-util": "^1.1.0",
		"marked": "^18.0.10",
		"wikiparser-node": "^1.46.4"
	},
	"devDependencies": {
		"@bhsd/code-standard": "^4.1.0",
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.11.0",
		"@codemirror/language": "^6.12.4",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/search": "^6.7.1",
		"@codemirror/state": "^6.7.1",
		"@codemirror/view": "^6.43.9",
		"diff2html-cli": "^5.2.15",
		"esbuild": "^0.28.2",
		"eslint": "^10.9.1",
		"http-server": "^14.1.1",
		"markdownlint-cli2": "^0.23.2",
		"stylelint": "^17.14.1",
		"typescript": "^6.0.3"
	}
}
